{
  "name": "crypto-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit": "npm audit --audit-level=high",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:sync-indexes": "npm run db:sync-indexes --workspace apps/api",
    "test:api": "npm run test --workspace apps/api"
  },
  "dependencies": {
    "jose": "^6.2.14",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
